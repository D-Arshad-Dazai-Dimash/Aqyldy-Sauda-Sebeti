<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ======================== CONSOLE (colored) ======================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} %highlight(%-5level) %cyan([%-20.20logger{0}]) — %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ======================== FILE (rolling daily) ======================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ======================== DEV profile ======================== -->
    <springProfile name="dev">

        <!-- our code: DEBUG -->
        <logger name="com.darshad.project" level="DEBUG" />

        <!-- SQL queries -->
        <logger name="org.hibernate.SQL"              level="DEBUG" />
        <logger name="org.hibernate.type.descriptor"   level="TRACE" />

        <!-- Spring Security filter chain -->
        <logger name="org.springframework.security"    level="DEBUG" />

        <!-- Spring Web (request mapping) -->
        <logger name="org.springframework.web"         level="DEBUG" />

        <!-- Flyway migrations -->
        <logger name="org.flywaydb"                    level="INFO" />

        <!-- Connection pool -->
        <logger name="com.zaxxer.hikari"               level="INFO" />

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- ======================== PROD profile ======================== -->
    <springProfile name="!dev">
        <logger name="com.darshad.project" level="INFO" />

        <root level="WARN">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

</configuration>
