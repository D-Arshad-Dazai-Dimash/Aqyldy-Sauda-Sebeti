# AI Service runs on the same Postgres as the Spring Boot backend.
# When running locally (outside Docker), these defaults connect to docker-compose DB.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=dbaqyldy
DB_USER=aqsa
DB_PASS=aqyldysebet123

# Groq API key for the AI chatbot (preferred provider).
# Without this key the chatbot falls back to a built-in rule-based system.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Legacy Google Gemini key — only used if GROQ_API_KEY is not set.
# GEMINI_API_KEY=your_gemini_api_key_here
